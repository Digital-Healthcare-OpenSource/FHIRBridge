{
  "$schema": "./mapping.schema.json",
  "description": "Japanese small-clinic Excel workbook with two sheets: 患者 (Patients) and 受診 (Encounters, one row per visit with its diagnosis). Kanji column headers; ICD-10 diagnosis codes. Rows on 受診 are linked to patients through 患者番号. Date cells may be real Excel dates or text in the given format. Times are JST (+09:00). Sample data: examples/data/jp-clinic.xlsx.",
  "sheet": {
    "Patient": "患者",
    "Encounter": "受診",
    "Condition": "受診"
  },
  "patientId": {
    "column": "患者番号",
    "system": "https://fhirbridge.example/identifiers/jp-clinic-patient-id"
  },
  "timezone": "+09:00",
  "fields": {
    "Patient.identifier[].value": "患者番号",
    "Patient.name.family": "姓",
    "Patient.name.given": "名",
    "Patient.gender": {
      "column": "性別",
      "valueMap": { "男": "male", "女": "female", "その他": "other", "不明": "unknown" }
    },
    "Patient.birthDate": {
      "column": "生年月日",
      "transform": "date",
      "format": "YYYY-MM-DD"
    },
    "Patient.address.line": "住所",
    "Patient.address.country": { "literal": "JP" },
    "Encounter.period.start": {
      "column": "受診日時",
      "transform": "datetime",
      "format": "YYYY-MM-DD HH:mm"
    },
    "Encounter.class.code": {
      "column": "受診区分",
      "valueMap": { "外来": "AMB", "入院": "IMP" }
    },
    "Condition.code.coding[].system": { "literal": "http://hl7.org/fhir/sid/icd-10" },
    "Condition.code.coding[].code": "診断コード",
    "Condition.code.text": "診断名"
  },
  "resourceTypes": ["Patient", "Encounter", "Condition"]
}
